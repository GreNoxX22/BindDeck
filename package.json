{
  "name": "binddeck",
  "productName": "BindDeck",
  "version": "1.1.1",
  "description": "Turn your phone into a customizable macro pad for your PC: tap a tile, send a key.",
  "author": "Z",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "server": "node server.js",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "express": "^4.21.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "hu.z.binddeck",
    "productName": "BindDeck",
    "copyright": "Copyright (c) 2026 Z",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "keys.ps1",
      "public/**/*",
      "build/icon.ico",
      "LICENSE"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "artifactName": "BindDeck-Setup-${version}.${ext}"
    },
    "asarUnpack": [
      "keys.ps1"
    ]
  },
  "binddeck": {
    "updateRepo": "GreNoxX22/BindDeck"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/GreNoxX22/BindDeck.git"
  },
  "homepage": "https://github.com/GreNoxX22/BindDeck"
}
